# ---------------------------------------------------------------------------
# 원본(RynnVLA-002 / VLA-GoT-release) 상속분 + 이 프로젝트용 추가.
#
# ⚠️ 상속된 초판은 `results/`, `*.csv`, `*.log`를 통째로 막고 있었다. 그대로
#    두면 §1의 주장 19개가 얹혀 있는 per_sample.csv / summary.json이 전부
#    리포에서 빠지고, git status에도 안 뜨므로 빠졌다는 사실조차 안 보인다.
#    아래 "결과" 절이 무게만 막고 증거는 되살린다.
# ---------------------------------------------------------------------------

# 가중치 (GitHub 파일 한도 100MB + 재배포 제약)
ckpts/
output/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# 결과 — 증거는 남기고 나머지는 막는다.
# `results/`(디렉토리 자체 제외)로 쓰면 git이 안으로 안 들어가서 아래 예외가
# 전부 무효가 된다. `results/**` + `!results/**/`가 그래서 필요하다.
# ★화이트리스트다. 예전엔 "csv/json은 다 통과 + 나쁜 것만 제외"였는데, 런이 37개라
#   제외 목록이 계속 자랐고 headline/ 안에 숨은 무효 런을 한 번 놓쳤다.
#   이제 여기 적힌 런만 들어간다. 새 런을 넣으려면 두 줄을 명시적으로 추가할 것.
results/**
!results/**/

# 논문 메인 표 — fill_paper_table.py 의 기본 --runs 가 정확히 이 셋이다
!results/headline/ref/per_sample.csv
!results/headline/ref/summary.json
!results/headline/ref_s43/per_sample.csv
!results/headline/ref_s43/summary.json
!results/headline/ref_s44/per_sample.csv
!results/headline/ref_s44/summary.json

# 주장 10 — 집계(final_top3) null. CONTROL 팔이 있어야 해석된다
!results/fusion/**/per_sample.csv
!results/fusion/**/summary.json

# 주장 8·9 — wm_main 이 원자료(n=250), wm_main_redo 가 정본 분석
#   (merged_from: results/wm_main/per_sample.csv, rho=-0.0091 은 여기에만 있다)
!results/wm_main/per_sample.csv
!results/wm_main/summary.json
!results/wm_main_redo/summary.json

# 게이트 sensitivity_mirror 0.74788 의 유일한 출처. ⚠️n=30 으로 wm_main(250)과 다르다
!results/wm_gate/per_sample.csv
!results/wm_gate/summary.json

# delta -> 미터 환산 곡선
!results/wm_eps/per_sample.csv
!results/wm_eps/summary.json

# 세션17 NAVSIM WM 게이트 FAIL 판정의 원자료
!results/wm_navsim_pilot/per_sample.csv
!results/wm_navsim_pilot/summary.json
!results/wm_navsim_gate/per_sample.csv
!results/wm_navsim_gate/summary.json

# 전처리 산출물 — preprocess_*.py로 재생성 가능.
# ⚠️ 다만 val split 정의(어떤 600건/150씬인지)는 재현성의 일부다. 크기를 재고
#    작으면 `git add -f`로 그 파일만 넣을 것:  du -sh data/*records*
data/navsim_records/
data/nuscenes_records/
# ★두 파일은 예외로 `git add -f` 해서 추적 중이다 — 재현성의 일부이기 때문:
#     nuscenes_val_scenespread.json  어떤 600건/150씬으로 쟀는지
#     nuscenes_norm.json             waypoint 정규화 상수(537바이트)
#   ⚠️ 디렉토리 자체를 막고 있으므로 `!` 예외 줄은 동작하지 않는다(git이 안으로
#      들어가지 않는다). 새로 넣을 파일도 반드시 `git add -f`를 써야 한다.

# 로그·미디어
*.mp4
*.log

# 파이썬
__pycache__/
*.pyc
*.egg-info/
xllmx.egg-info/
.DS_Store

# ---------------------------------------------------------------------------
# 2026-08-21 리포 분할 이후 추가.
# ⚠️ 이 리포가 이제 독립 루트다(예전 상위 WorldVLA_GoT/의 .gitignore가 더는
#    안 걸린다). 상위가 막아 주던 것 중 이 트리에 생길 수 있는 것만 옮겨 적는다.
# ---------------------------------------------------------------------------
# settings.local.json에 로컬 사용자 경로가 들어간다
.claude/
# 발표자료 — ⚠️수치가 문서 갱신을 따라가지 않는다
*.pptx

# ---------------------------------------------------------------------------
# 상류(RynnVLA-002) 상속분 중 주행 트랙과 무관한 것 — 2026-08-21 첫 push 전 제외.
# 디스크에는 그대로 두고 추적만 끊었다(LIBERO 재현이 필요해지면 원본 리포에 있다).
#   assets/  28 MB. LIBERO 데모 GIF. md·py·sh 어디에서도 참조 0건이었다
#   libero_util/  5.3 MB. LIBERO 전용, 주행 코드가 import하지 않는다
# ⚠️ got_vla_v2/ 는 남긴다 — README §출처의 "구현된 것은 beam search(ToT)"
#    논증 근거이고 got_drive/의 주석 4곳이 이것을 대조군으로 가리킨다.
# ---------------------------------------------------------------------------
assets/
libero_util/
eval_solver_libero_got_v2.py

# ---------------------------------------------------------------------------
# 서버(server03) 작업 트리에만 존재하는 산출물 — 로컬엔 없어서 2026-08-21까지
# 규칙이 비어 있었다. 서버에서 clone해 쓸 때 통째로 딸려 오는 것을 막는다.
# ⚠️ feats/ 안에 증거(json·csv)가 있으면 그 파일만 `git add -f`로 넣을 것.
#    먼저 재 볼 것:  du -sh feats && find feats -size +50M
# ---------------------------------------------------------------------------
feats/
*.npy
*.npz
*.pkl

# ⚠️ 위 화이트리스트에 없는 런은 전부 자동 제외된다. 특히:
#   results/lik_SESSION6_randomcrop_DO_NOT_MIX/ 와
#   results/headline/wide_SESSION6_randomcrop_DO_NOT_MIX/ 는 §7에서 평가 경로의
#   랜덤 크롭이 발견되기 전 수치라 **무효**다. 리포에 넣으면 정상 런과 섞여 인용된다.


# WM 레코드 — 위 data/*_records/ 규칙이 이름 때문에 놓쳤다(_wm_records).
# preprocess_*_wm.py 로 재생성되고, 레코드마다 서버 절대경로가 들어 있다.
data/nuscenes_wm_records/
data/navsim_wm_records/
